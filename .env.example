# Server
PORT=4000
NODE_ENV=development

# The base URL this API is reachable at (used to build absolute links,
# e.g. certificate verification QR codes)
API_BASE_URL=http://localhost:4000

# The URL(s) allowed to call this API (comma-separated). Point this at
# wherever learnovaApp / admin are running.
# In production this is REQUIRED  the server refuses to start without it
# rather than silently falling back to allowing any origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/learnova

# Clerk (auth)  server-side only, never exposed to mobile/admin clients
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# OpenAI  server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional  only needed to point at a non-default OpenAI-compatible base URL
OPENAI_BASE_URL=

# GitHub  server-side only, used by the project-evaluation pipeline to
# read submitted repos. Optional: unauthenticated access works for public
# repos at a lower rate limit; a personal access token (repo:read is
# enough) raises that limit and is a prerequisite for private-repo support.
GITHUB_TOKEN=

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Certificate verification links point back at admin's public verify page
CERTIFICATE_VERIFY_BASE_URL=http://localhost:3000/verify

# Uploaded-video pipeline (S3 -> MediaConvert -> CloudFront). All optional
# at boot  the app works fine without them (e.g. YouTube-hosted lessons
# still work); calls that actually need one throw a clear error only when
# used, not at startup.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_MEDIACONVERT_ENDPOINT=
AWS_MEDIACONVERT_ROLE_ARN=
# Shared secret checked on the MediaConvert status webhook (set the same
# value as a custom header in the EventBridge API destination's connection:
# Configure -> Authorization -> API key)
AWS_MEDIACONVERT_WEBHOOK_SECRET=
AWS_CLOUDFRONT_DOMAIN=
AWS_CLOUDFRONT_KEY_PAIR_ID=
AWS_CLOUDFRONT_PRIVATE_KEY=

# Optional caching + background-job layer. Leave unset and the app runs
# exactly as it does today (in-process, no caching)  every Redis-backed
# feature fails open to Mongo/synchronous behavior when this is empty or
# unreachable, it is never required for the app to function.
REDIS_URL=

# Optional error-monitoring (Sentry). Leave unset to skip Sentry entirely.
SENTRY_DSN=

# Optional  controls structured log verbosity (fatal/error/warn/info/debug/trace)
LOG_LEVEL=info

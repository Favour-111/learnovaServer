# Server
PORT=4000
NODE_ENV=development

# The base URL this API is reachable at (used to build absolute links,
# e.g. certificate verification QR codes)
API_BASE_URL=http://localhost:4000

# The URL(s) allowed to call this API (comma-separated). Point this at
# wherever learnovaApp / admin are running.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/learnova

# Clerk (auth)  server-side only, never exposed to mobile/admin clients
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# OpenAI  server-side only
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub  server-side only, used by the project-evaluation pipeline to
# read submitted repos. Optional: unauthenticated access works for public
# repos at a lower rate limit; a personal access token (repo:read is
# enough) raises that limit and is a prerequisite for private-repo support.
GITHUB_TOKEN=

# Firebase Cloud Messaging (push notifications)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Certificate verification links point back at admin's public verify page
CERTIFICATE_VERIFY_BASE_URL=http://localhost:3000/verify

# Admin JWT/session secret (used for admin-only endpoints)
ADMIN_SESSION_SECRET=change-me-in-production
